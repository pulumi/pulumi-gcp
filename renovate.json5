{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>pulumi/renovate-config//default.json5"],

  // Also run against the v9 maintenance branch, which only takes security
  // fixes: disable ordinary updates there so only vulnerability alerts
  // raise PRs.
  baseBranchPatterns: ["$default", "v9"],
  packageRules: [
    {
      matchBaseBranches: ["v9"],
      matchPackageNames: ["*"],
      enabled: false,
    },
    // Bump the go directive in go.mod, which Renovate leaves alone by default:
    // https://docs.renovatebot.com/modules/manager/gomod/
    // enabled re-allows it on v9, overriding the rule above, so Go security
    // releases reach the maintenance branch too.
    {
      matchManagers: ["gomod"],
      matchDepNames: ["go"],
      matchDepTypes: ["golang"],
      rangeStrategy: "bump",
      enabled: true,
    },
    // These workflows and composite actions are generated by
    // https://github.com/pulumi/ci-mgmt (each carries its "WARNING: This file
    // is autogenerated" header) and get overwritten whenever ci-mgmt syncs.
    // A Renovate PR that edits an action pin here, like #4235 bumping
    // pulumi/pulumi-package-publisher in publish.yml, is reverted by the next
    // sync and just creates churn. Bump the pin in ci-mgmt's templates
    // instead: https://github.com/pulumi/ci-mgmt/tree/master/provider-ci/internal/pkg/templates
    // so the fix flows back out to every provider it manages, this one
    // included.
    //
    // This uses `packageRules` + `enabled: false` rather than `ignorePaths`
    // because `ignorePaths` is non-mergeable: redeclaring it here would
    // replace, not add to, the `ignorePaths` the extended preset already
    // sets (notably the generated `sdk/**`), and that must keep applying.
    // `packageRules` *is* mergeable, so this adds to the preset instead of
    // silently dropping part of it.
    {
      matchManagers: ["github-actions"],
      matchFileNames: [
        ".github/actions/download-prerequisites/action.yml",
        ".github/actions/download-provider/action.yml",
        ".github/actions/download-sdk/action.yml",
        ".github/actions/upload-prerequisites/action.yml",
        ".github/actions/upload-sdk/action.yml",
        ".github/workflows/build_provider.yml",
        ".github/workflows/build_sdk.yml",
        ".github/workflows/ci.yml",
        ".github/workflows/command-dispatch.yml",
        ".github/workflows/comment-on-stale-issues.yml",
        ".github/workflows/community-moderation.yml",
        ".github/workflows/export-repo-secrets.yml",
        ".github/workflows/license.yml",
        ".github/workflows/lint.yml",
        ".github/workflows/main-post-build.yml",
        ".github/workflows/main.yml",
        ".github/workflows/maintenance-release.yml",
        ".github/workflows/maintenance-scan.yml",
        ".github/workflows/prerelease.yml",
        ".github/workflows/prerequisites.yml",
        ".github/workflows/publish.yml",
        ".github/workflows/pull-request.yml",
        ".github/workflows/release.yml",
        ".github/workflows/release_command.yml",
        ".github/workflows/run-acceptance-tests.yml",
        ".github/workflows/test.yml",
        ".github/workflows/update-skills.yml",
        ".github/workflows/upgrade-bridge.yml",
        ".github/workflows/upgrade-provider.yml",
        ".github/workflows/verify-release.yml",
      ],
      enabled: false,
    },
    // Same story for the tool versions ci-mgmt pins in .config/mise*.toml:
    // Renovate bumped Node to v24.22.1 in #4173, and the very next ci-mgmt
    // sync (#4180) silently reverted it back to v24.18.0 a few hours later.
    {
      matchManagers: ["mise"],
      matchFileNames: [".config/mise.toml", ".config/mise.test.toml"],
      enabled: false,
    },
  ],
  // Vulnerability-fix PRs inherit this as a forced override, which re-enables
  // the packages the v9 rule above disables. Same as Renovate's
  // security:only-security-updates preset.
  vulnerabilityAlerts: {
    enabled: true,
  },
}
