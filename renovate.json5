{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>pulumi/renovate-config//default.json5"],

  // Also run against the v9 maintenance branch, which only takes security
  // fixes: disable ordinary updates there so only vulnerability alerts
  // raise PRs.
  baseBranchPatterns: ["$default", "v9"],
  packageRules: [
    {
      matchBaseBranches: ["v9"],
      matchPackageNames: ["*"],
      enabled: false,
    },
  ],
  vulnerabilityAlerts: {
    enabled: true,
  },
}
