{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>pulumi/renovate-config//default.json5"],

  // Also run against the v9 maintenance branch, which only takes security
  // fixes: disable ordinary updates there so only vulnerability alerts
  // raise PRs.
  baseBranchPatterns: ["$default", "v9"],
  packageRules: [
    {
      matchBaseBranches: ["v9"],
      matchPackageNames: ["*"],
      enabled: false,
    },
    // Bump the go directive in go.mod, which Renovate leaves alone by default:
    // https://docs.renovatebot.com/modules/manager/gomod/
    // enabled re-allows it on v9, overriding the rule above, so Go security
    // releases reach the maintenance branch too.
    {
      matchManagers: ["gomod"],
      matchDepNames: ["go"],
      matchDepTypes: ["golang"],
      rangeStrategy: "bump",
      enabled: true,
    },
    // ci-mgmt (https://github.com/pulumi/ci-mgmt) owns these files and
    // overwrites them on every sync, so Renovate edits here (e.g. #4235 on
    // publish.yml) just get reverted. packageRules, not ignorePaths: the
    // latter is non-mergeable and would drop the preset's own ignores
    // (e.g. generated sdk/**) instead of adding to them.
    {
      matchManagers: ["github-actions"],
      matchFileNames: [
        ".github/actions/download-prerequisites/action.yml",
        ".github/actions/download-provider/action.yml",
        ".github/actions/download-sdk/action.yml",
        ".github/actions/upload-prerequisites/action.yml",
        ".github/actions/upload-sdk/action.yml",
        ".github/workflows/build_provider.yml",
        ".github/workflows/build_sdk.yml",
        ".github/workflows/ci.yml",
        ".github/workflows/command-dispatch.yml",
        ".github/workflows/comment-on-stale-issues.yml",
        ".github/workflows/community-moderation.yml",
        ".github/workflows/export-repo-secrets.yml",
        ".github/workflows/license.yml",
        ".github/workflows/lint.yml",
        ".github/workflows/main-post-build.yml",
        ".github/workflows/main.yml",
        ".github/workflows/maintenance-release.yml",
        ".github/workflows/maintenance-scan.yml",
        ".github/workflows/prerelease.yml",
        ".github/workflows/prerequisites.yml",
        ".github/workflows/publish.yml",
        ".github/workflows/pull-request.yml",
        ".github/workflows/release.yml",
        ".github/workflows/release_command.yml",
        ".github/workflows/run-acceptance-tests.yml",
        ".github/workflows/test.yml",
        ".github/workflows/update-skills.yml",
        ".github/workflows/upgrade-bridge.yml",
        ".github/workflows/upgrade-provider.yml",
        ".github/workflows/verify-release.yml",
      ],
      enabled: false,
    },
    // Same for the tool versions ci-mgmt pins in .config/mise*.toml: a Node
    // bump here (#4173) was silently reverted by the next sync (#4180).
    {
      matchManagers: ["mise"],
      matchFileNames: [".config/mise.toml", ".config/mise.test.toml"],
      enabled: false,
    },
    // Compute Engine publishes a new debian-<major> image family some days
    // after the Debian release itself; wait before proposing the bump so the
    // family exists when the example tests run.
    {
      matchManagers: ["custom.regex"],
      matchDatasources: ["endoflife-date"],
      matchPackageNames: ["debian"],
      commitMessageTopic: "Debian Compute Engine image family",
      minimumReleaseAge: "30 days",
    },
  ],
  // Vulnerability-fix PRs inherit this as a forced override, which re-enables
  // the packages the v9 rule above disables. Same as Renovate's
  // security:only-security-updates preset.
  vulnerabilityAlerts: {
    enabled: true,
  },

  customManagers: [
    // Debian image families on Compute Engine (debian-cloud/debian-<major>)
    // used by the live example tests. GCE image families have no Renovate
    // datasource, but each family tracks one Debian major release, so follow
    // Debian's release cycles from endoflife.date instead:
    // https://docs.renovatebot.com/modules/datasource/endoflife-date/
    // Limited to examples/: test programs under provider/test-programs are
    // replayed against recorded gRPC traffic and must keep their pinned image,
    // and sdk/ and upstream/ are generated or vendored.
    {
      customType: "regex",
      managerFilePatterns: ["/^examples/.+\\.(ts|js|py|go|cs|java|ya?ml)$/"],
      matchStrings: [
        // The trailing [^-\\w] rejects dated images such as debian-11-bullseye-v20220719.
        "debian-cloud/(?:global/images/family/)?debian-(?<currentValue>\\d+)[^-\\w]",
      ],
      depNameTemplate: "debian",
      datasourceTemplate: "endoflife-date",
      versioningTemplate: "loose",
      // The datasource reports each cycle's latest point release (13.7); the
      // image family only carries the major.
      extractVersionTemplate: "^(?<version>\\d+)",
    },
  ],
}
